# Postgres en Supabase (pooler para runtime, direct para migrations)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-X-XX-X.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-X-XX-X.pooler.supabase.com:5432/postgres"

# Auth (generar con: openssl rand -hex 32)
AUTH_SECRET="generar-con-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage (file uploads de fotos, planos, actas)
# completar con datos del proyecto Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Pre-llenar credenciales demo en login (solo dev)
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="true"

# Sentry (observabilidad, opcional)
# Si no se setea, la app funciona normal sin reporte a Sentry
NEXT_PUBLIC_SENTRY_DSN=""

# App URL (usado en links de emails — debe coincidir con el dominio público)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (envío de emails: signup welcome, password reset, invites)
# Sin clave: los emails se imprimen en consola (dev). Ver docs/RESEND_SETUP.md
RESEND_API_KEY=""
EMAIL_FROM="Noctua <onboarding@resend.dev>"

# Upstash Redis (rate limiting anti brute-force)
# Sin estas vars: fallback en memoria (no robusto en serverless). Ver docs/UPSTASH_SETUP.md
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# MapTiler (satélite premium para /mapa) — OPCIONAL
# Sin clave: el mapa usa satélite gratis de Esri World Imagery (igual se ve bien).
# Con clave: satélite MapTiler (más nítido). Crear cuenta gratis en maptiler.com
# → Account → API keys. Free tier: 100k cargas/mes.
NEXT_PUBLIC_MAPTILER_KEY=""
