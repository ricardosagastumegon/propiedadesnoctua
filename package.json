{
    "name": "inmobiliaria-pro",
    "version": "0.1.0",
    "private": true,
    "browserslist": [
        "chrome >= 100",
        "edge >= 100",
        "firefox >= 100",
        "safari >= 15.4",
        "ios_saf >= 15.4"
    ],
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint",
        "postinstall": "prisma generate",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/client",
            "prisma",
            "@prisma/engines",
            "esbuild"
        ]
    },
    "dependencies": {
