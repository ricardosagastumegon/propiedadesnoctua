generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String   @default("FAMILY")
  taxId     String?
  logoUrl   String?
  currency  String   @default("GTQ")
  timezone  String   @default("America/Guatemala")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  properties       Property[]
  tenants          Tenant[]
  contracts        Contract[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  maintenances     MaintenanceRequest[]
  assets           Asset[]
  projects         Project[]
  vendors          Vendor[]
  quotes           Quote[]
  employees        Employee[]
  documents        Document[]
  notifications    Notification[]
  approvalRequests ApprovalRequest[]
  assetRecordTypes AssetRecordType[]
  vendorInvoices   VendorInvoice[]
  pettyCashes      PettyCash[]
  acquisitionCandidates AcquisitionCandidate[]
  acquisitionLinksOwned        AcquisitionLink[] @relation("AcqLinkOwner")
  acquisitionLinksIntermediary AcquisitionLink[] @relation("AcqLinkIntermediary")
  activityLogs     ActivityLog[]
  settings         OrganizationSettings?
  serviceAcceptances ServiceAcceptance[]
}

model OrganizationSettings {
  organizationId          String @id
  prepaymentCapPercentage Int    @default(80)
  // Módulos habilitados para esta organización (array de claves de Module).
  // null = todos habilitados. Permite tenants "modo inmobiliario" con menos módulos.
  enabledModules          Json?
  // Token del link público para que agentes externos envíen propiedades (módulo Adquisiciones).
  acquisitionToken        String?  @unique
  // Requerimiento actual que se muestra a los agentes en el link (ej. "Busco gasolineras").
  acquisitionBrief        String?
  // Código que este tenant comparte para que otro lo asigne como intermediario.
  intermediaryCode        String?  @unique
  // Tipo de cambio USD→GTQ para conversiones (configurable).
  fxUsdGtq                Float    @default(7.5)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Link público de Adquisiciones. Un tenant puede tener varios: cada uno con su
// nombre, su requerimiento (brief) y, opcional, un tenant INTERMEDIARIO que ve
// (solo lectura) lo que entra por ese link.
model AcquisitionLink {
  id                String   @id @default(cuid())
  organizationId    String   // dueño (A)
  token             String   @unique
  name              String   @default("Link")
  brief             String?  // requerimiento que ven los agentes
  intermediaryOrgId String?  // tenant intermediario (B), opcional — lo asigna el super-admin
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  organization Organization  @relation("AcqLinkOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  intermediary Organization? @relation("AcqLinkIntermediary", fields: [intermediaryOrgId], references: [id], onDelete: SetNull)
  candidates   AcquisitionCandidate[]

  @@index([organizationId])
  @@index([intermediaryOrgId])
}

// Propiedad candidata a compra, enviada por un agente externo vía link público.
model AcquisitionCandidate {
  id             String   @id @default(cuid())
  organizationId String
  linkId         String?  // por qué link entró (para dueño + intermediario)
  stage          String   @default("NEW") // NEW | OFFERED | ACCEPTED | DISCARDED
  // Datos de la propiedad
  title          String
  propertyType   String?
  department     String?
  city           String?
  zone           String?
  addressLine    String?
  cadastralNumber String? // nº de catastro (RIC) — obligatorio o su alternativa (polígono)
  mapPolygon     Json?    // contorno/ubicación dibujada [lat,lon]
  latitude       Float?   // centroide o pin (para el mapa general)
  longitude      Float?
  price          Float?
  currency       String   @default("GTQ")
  bedrooms       Int?
  bathrooms      Int?
  area           Float?
  description    String?
  galleryUrls    String[] @default([])
  documentUrls   String[] @default([]) // documentos de municipalidad (plano, escritura) — PDF/imagen
  // Contacto del agente que la envió
  agentName      String?
  agentPhone     String?
  agentEmail     String?
  // Análisis del cliente
  analysisNotes  String?
  estimatedValue Float?
  offerAmount    Float?
  // Motor de análisis por vara² (v²)
  areaUnit       String?  // V2 | M2 | CUERDA | MANZANA | HECTAREA | CABALLERIA
  cuerdaVaras    Int?     // tamaño de cuerda (varas por lado) si areaUnit = CUERDA
  refPriceMinV2  Float?   // referencia de mercado: precio mín por v²
  refPriceMaxV2  Float?   // referencia de mercado: precio máx por v²
  isCommercial   Boolean  @default(false)
  offerPerV2     Float?   // oferta elegida por v² (sugerida + editable)
  source         String   @default("PUBLIC_FORM")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  link         AcquisitionLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  negotiations AcquisitionNegotiation[]

  @@index([organizationId, stage])
  @@index([linkId])
}

// Registro de negociación de una candidata (pidieron/ofrecí/reofertaron…).
model AcquisitionNegotiation {
  id             String   @id @default(cuid())
  candidateId    String
  organizationId String
  kind           String   // ASKED | OFFERED | COUNTER | OTHER
  amount         Float
  currency       String   @default("GTQ")
  note           String?
  createdAt      DateTime @default(now())

  candidate AcquisitionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

// role: OWNER | ADMIN | MANAGER | ACCOUNTANT | SUPERVISOR | ASSISTANT | TECHNICIAN | VIEWER
// authorityPolicy: NONE | ALONE | COSIGN_REQUIRED
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String?
  emailVerified       DateTime?
  image               String?
  role                String    @default("VIEWER")
  authorityPolicy     String    @default("NONE")
  canAcceptServices   Boolean   @default(false)
  phone               String?
  organizationId      String
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  invitedById         String?
  invitedAt           DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy            User?                @relation("UserInviter", fields: [invitedById], references: [id])
  invited              User[]               @relation("UserInviter")
  notifications        Notification[]
  assignedTickets      MaintenanceRequest[] @relation("AssignedTo")
  cosignPolicy         CosignPolicy?        @relation("PolicyOwner")
  cosignAllowedIn      CosignPolicy[]       @relation("CosignAllowed")
  approvalRequestsMade ApprovalRequest[]    @relation("ApprovalRequested")
  approvalsCosign      ApprovalRequest[]    @relation("ApprovalCosigner")
  approvalsApproved    ApprovalRequest[]    @relation("ApprovalApproved")
  approvalsRejected    ApprovalRequest[]    @relation("ApprovalRejected")
  serviceAcceptancesRequested ServiceAcceptance[] @relation("AcceptanceRequested")
  serviceAcceptancesAccepted  ServiceAcceptance[] @relation("AcceptanceAccepted")
  serviceAcceptancesRejected  ServiceAcceptance[] @relation("AcceptanceRejected")
  createdQuotes        Quote[]              @relation("QuoteCreator")
  propertyAccess       UserPropertyAccess[]
  passwordResetTokens  PasswordResetToken[]

  @@index([organizationId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// Acceso de un usuario a propiedades específicas.
// Regla: usuario sin filas en esta tabla → ve TODAS las propiedades de su org (OWNER/ADMIN).
//        usuario con 1+ filas → ve SOLO esas propiedades (encargados, SUPERVISORs).
model UserPropertyAccess {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// entityType: PARTIDA | TICKET
// status: PENDING | ACCEPTED | REJECTED | SUPERSEDED
model ServiceAcceptance {
  id                  String    @id @default(cuid())
  organizationId      String
  entityType          String
  entityId            String
  projectId           String?
  status              String    @default("PENDING")
  version             Int       @default(0) // optimistic lock para evitar race conditions
  requestedById       String
  acceptedById        String?
  rejectedById        String?
  requestedAt         DateTime  @default(now())
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  checklist           String?
  rating              Int?
  notes               String?
  rejectionReason     String?
  requiredCorrections String?
  verificationHash    String?
  contextSnapshot     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User                      @relation("AcceptanceRequested", fields: [requestedById], references: [id])
  acceptedBy   User?                     @relation("AcceptanceAccepted", fields: [acceptedById], references: [id])
  rejectedBy   User?                     @relation("AcceptanceRejected", fields: [rejectedById], references: [id])
  photos       ServiceAcceptancePhoto[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([projectId])
}

model ServiceAcceptancePhoto {
  id           String   @id @default(cuid())
  acceptanceId String
  url          String
  caption      String?
  createdAt    DateTime @default(now())

  acceptance ServiceAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
}

model CosignPolicy {
  id     String @id @default(cuid())
  userId String @unique

  user             User   @relation("PolicyOwner", fields: [userId], references: [id], onDelete: Cascade)
  allowedCosigners User[] @relation("CosignAllowed")
}

// entityType: QUOTE | CONTRACT | VENDOR_INVOICE | INVOICE_MODIFIED | VENDOR | PARTIDA | TICKET
// status: PENDING | PENDING_COSIGN | APPROVED | REJECTED
model ApprovalRequest {
  id              String    @id @default(cuid())
  organizationId  String
  entityType      String
  entityId        String
  requestedById   String
  cosignerId      String?
  status          String    @default("PENDING")
  approvedById    String?
  rejectedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  cosignedAt      DateTime?
  rejectionReason String?
  notes           String?
  title           String?
  amount          Float?
  relatedId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User                @relation("ApprovalRequested", fields: [requestedById], references: [id])
  cosigner       User?               @relation("ApprovalCosigner", fields: [cosignerId], references: [id])
  approvedBy     User?               @relation("ApprovalApproved", fields: [approvedById], references: [id])
  rejectedBy     User?               @relation("ApprovalRejected", fields: [rejectedById], references: [id])
  ticketApproval MaintenanceRequest? @relation("TicketApproval")
  quote          Quote?              @relation("QuoteApproval")

  @@index([organizationId, status])
  @@index([entityType, entityId])
}

model Property {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  alias           String?
  type            String
  status          String    @default("AVAILABLE")
  addressLine     String
  zone            String?
  city            String
  department      String
  country         String    @default("Guatemala")
  postalCode      String?
  latitude        Float?
  longitude       Float?
  // Contorno del lote: array de vértices [lat, lon] en JSON.
  // Si existe, en el mapa se dibuja el polígono; si no, un pin en lat/lon.
  mapPolygon      Json?
  totalArea       Float?
  builtArea       Float?
  bedrooms        Int?
  bathrooms       Float?
  parkingSpaces   Int?
  yearBuilt       Int?
  acquisitionDate DateTime?
  acquisitionCost Float?
  currentValue    Float?
  propertyTaxYear Float?
  notes           String?
  coverImageUrl   String?
  // Galería de fotos adicionales (URLs). Para fichas inmobiliarias.
  galleryUrls     String[]  @default([])
  // Token para compartir la propiedad públicamente (solo lectura, sin login).
  // null = no compartida. Se genera/revoca desde el detalle.
  publicShareToken String?  @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units          PropertyUnit[]
  parcels        PropertyParcel[]
  contracts      Contract[]
  maintenances   MaintenanceRequest[]
  assets         Asset[]
  projects       Project[]
  expenses       Expense[]
  documents      Document[]
  plans          Plan[]
  utilities      UtilityAccount[]
  vendorInvoices VendorInvoice[]
  pettyCash      PettyCash?
  userAccess     UserPropertyAccess[]

  @@index([organizationId])
  @@index([status])
}

// Predio / parcela catastral dentro de una finca (Property).
// Una finca puede tener varios predios, cada uno con su número de catastro RIC
// y su propio polígono. El área de la finca = suma de las áreas de sus predios.
model PropertyParcel {
  id              String   @id @default(cuid())
  propertyId      String
  name            String?  // ej. "Predio norte", "Lote 2"
  cadastralNumber String?  // nº de catastro RIC, ej. "18-03-06-00001"
  mapPolygon      Json?    // contorno LEGAL (del plano/RIC) — array [lat, lon]
  areaHectares    Float?   // área legal calculada
  realPolygon     Json?    // contorno REAL (medido en campo) — array [lat, lon]
  realAreaHectares Float?  // área real calculada
  notes           String?
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@index([propertyId])
}

model PropertyUnit {
  id         String  @id @default(cuid())
  propertyId String
  unitNumber String
  bedrooms   Int?
  bathrooms  Float?
  area       Float?
  notes      String?

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@unique([propertyId, unitNumber])
}

model Tenant {
  id               String   @id @default(cuid())
  organizationId   String
  type             String   @default("INDIVIDUAL")
  fullName         String
  documentType     String
  documentNumber   String
  email            String?
  phone            String
  alternatePhone   String?
  occupation       String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts    Contract[]

  @@index([organizationId])
  @@index([documentNumber])
}

model Contract {
  id                String    @id @default(cuid())
  organizationId    String
  contractNumber    String
  propertyId        String
  unitId            String?
  parcelId          String?   // si aplica a un predio específico; null = finca completa
  tenantId          String
  startDate         DateTime
  endDate           DateTime
  monthlyRent       Float
  currency          String    @default("GTQ")
  deposit           Float?
  paymentDueDay     Int
  paymentFrequency  String    @default("MONTHLY")
  includesUtilities Boolean   @default(false)
  utilitiesNotes    String?
  lateFeePercent    Float?
  annualIncrease    Float?
  status            String    @default("DRAFT")
  signedAt          DateTime?
  terminatedAt      DateTime?
  terminationReason String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property        @relation(fields: [propertyId], references: [id])
  unit         PropertyUnit?   @relation(fields: [unitId], references: [id])
  parcel       PropertyParcel? @relation(fields: [parcelId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  invoices     Invoice[]
  payments     Payment[]
  documents    Document[]

  @@unique([organizationId, contractNumber])
  @@index([status])
  @@index([endDate])
}

model Invoice {
  id                 String    @id @default(cuid())
  organizationId     String
  contractId         String?
  number             String
  satSerie           String?
  satNumber          String?
  satUuid            String?
  issueDate          DateTime
  dueDate            DateTime
  periodStart        DateTime?
  periodEnd          DateTime?
  subtotal           Float
  taxAmount          Float     @default(0)
  total              Float
  paidAmount         Float     @default(0)
  balance            Float
  currency           String    @default("GTQ")
  status             String    @default("DRAFT")
  isModified         Boolean   @default(false)
  modificationType   String?
  modificationAmount Float?
  modificationReason String?
  notes              String?
  pdfUrl             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract?     @relation(fields: [contractId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@index([organizationId, number])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String?
  invoiceId      String?
  amount         Float
  currency       String   @default("GTQ")
  paymentDate    DateTime
  method         String
  reference      String?
  bankName       String?
  notes          String?
  receiptUrl     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract?    @relation(fields: [contractId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, paymentDate])
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String?
  projectId      String?
  category       String
  amount         Float
  currency       String   @default("GTQ")
  date           DateTime
  description    String
  vendor         String?
  vendorId       String?
  invoiceRef     String?
  receiptUrl     String?
  isRecurring    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  vendorEntity Vendor?      @relation(fields: [vendorId], references: [id])

  @@index([organizationId, date])
  @@index([category])
}

model UtilityAccount {
  id            String  @id @default(cuid())
  propertyId    String
  type          String
  provider      String
  accountNumber String
  meterNumber   String?
  notes         String?

  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bills    UtilityBill[]
}

model UtilityBill {
  id               String    @id @default(cuid())
  utilityAccountId String
  periodStart      DateTime
  periodEnd        DateTime
  consumption      Float?
  amount           Float
  dueDate          DateTime
  isPaid           Boolean   @default(false)
  paidAt           DateTime?
  receiptUrl       String?

  account UtilityAccount @relation(fields: [utilityAccountId], references: [id], onDelete: Cascade)
}

// paymentMode: CAJA_CHICA | PROVEEDOR | EFECTIVO_RESPONSABLE | REEMBOLSO
model MaintenanceRequest {
  id                   String    @id @default(cuid())
  organizationId       String
  ticketNumber         String
  propertyId           String
  assetId              String?
  category             String
  priority             String    @default("MEDIUM")
  status               String    @default("REPORTED")
  title                String
  description          String
  reportedBy           String?
  reportedPhone        String?
  reportedAt           DateTime  @default(now())
  assignedToId         String?
  assignedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  estimatedCost        Float?
  actualCost           Float?
  resolutionNotes      String?
  paymentMode          String?
  vendorId             String?
  totalAmount          Float?
  amountPaid           Float     @default(0)
  escalatedToProjectId String?   @unique
  escalatedAt          DateTime?
  escalatedById        String?
  approvalRequestId    String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property         Property                  @relation(fields: [propertyId], references: [id])
  asset            Asset?                    @relation(fields: [assetId], references: [id])
  assignedTo       User?                     @relation("AssignedTo", fields: [assignedToId], references: [id])
  vendor           Vendor?                   @relation("TicketVendor", fields: [vendorId], references: [id])
  escalatedProject Project?                  @relation("EscalatedProject", fields: [escalatedToProjectId], references: [id])
  approvalRequest  ApprovalRequest?          @relation("TicketApproval", fields: [approvalRequestId], references: [id])
  photos           MaintenancePhoto[]
  ticketQuotes     Quote[]                   @relation("TicketQuotes")
  ticketPayments   TicketPayment[]
  timelineEvents   MaintenanceTimelineEvent[]
  pettyCashMovements PettyCashMovement[]

  @@unique([organizationId, ticketNumber])
  @@index([status])
  @@index([propertyId])
}

model MaintenancePhoto {
  id        String   @id @default(cuid())
  requestId String
  url       String
  caption   String?
  isAfter   Boolean  @default(false)
  createdAt DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// method: CAJA_CHICA | TRANSFER | CASH | REIMBURSEMENT
model TicketPayment {
  id                 String   @id @default(cuid())
  ticketId           String
  vendorId           String?
  amount             Float
  method             String
  date               DateTime
  reference          String?
  notes              String?
  percentageOfTotal  Float?
  closesWithDiscount Boolean  @default(false)
  discountAmount     Float?
  discountReason     String?
  createdAt          DateTime @default(now())

  ticket MaintenanceRequest @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  vendor Vendor?            @relation("TicketPaymentVendor", fields: [vendorId], references: [id])
}

// type: STATUS_CHANGE | NOTE | QUOTE_ADDED | PAYMENT | ASSIGNMENT | PHOTO | ESCALATED
model MaintenanceTimelineEvent {
  id        String   @id @default(cuid())
  ticketId  String
  type      String
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  ticket MaintenanceRequest @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Asset {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String?
  category       String
  name           String
  brand          String?
  model          String?
  serialNumber   String?
  purchaseDate   DateTime?
  purchaseCost   Float?
  currentValue   Float?
  warranty       DateTime?
  status         String    @default("ACTIVE")
  location       String?
  notes          String?
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?            @relation(fields: [propertyId], references: [id])
  maintenances MaintenanceRequest[]
  serviceLogs  AssetServiceLog[]
  records      AssetRecord[]

  @@index([organizationId])
  @@index([category])
}

model AssetServiceLog {
  id            String    @id @default(cuid())
  assetId       String
  serviceType   String
  date          DateTime
  cost          Float
  performedBy   String?
  nextServiceAt DateTime?
  notes         String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model AssetRecordType {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  code             String
  description      String?
  isSystem         Boolean  @default(false)
  requiresExpiry   Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      AssetRecord[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model AssetRecord {
  id               String    @id @default(cuid())
  assetId          String
  recordTypeId     String
  title            String
  description      String?
  issueDate        DateTime?
  expiryDate       DateTime?
  fileUrl          String?
  isActive         Boolean   @default(true)
  notifyDaysBefore Int       @default(30)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  asset      Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  recordType AssetRecordType @relation(fields: [recordTypeId], references: [id])

  @@index([assetId])
  @@index([expiryDate])
}

model Project {
  id              String    @id @default(cuid())
  organizationId  String
  propertyId      String?
  type            String
  name            String
  description     String?
  status          String    @default("PLANNING")
  startDate       DateTime?
  endDate         DateTime?
  actualEndDate   DateTime?
  budgetEstimate  Float?
  currency        String    @default("GTQ")
  progressPercent Int       @default(0)
  notes           String?
  coverImageUrl   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property?            @relation(fields: [propertyId], references: [id])
  tasks          ProjectTask[]
  costs          ProjectCost[]
  expenses       Expense[]
  quotes         Quote[]
  documents      Document[]
  assignments    EmployeeAssignment[]
  partidas       ProjectPartida[]
  vendorInvoices VendorInvoice[]
  escalatedTicket MaintenanceRequest? @relation("EscalatedProject")

  @@index([organizationId])
  @@index([status])
}

model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      String    @default("TODO")
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  orderIndex  Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  type        String
  description String
  amount      Float
  date        DateTime
  vendorId    String?
  notes       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor? @relation(fields: [vendorId], references: [id])
}

// status: PENDING | QUOTING | APPROVED | IN_PROGRESS | COMPLETED | CANCELLED
model ProjectPartida {
  id              String    @id @default(cuid())
  projectId       String
  name            String
  description     String?
  budgetEstimate  Float?
  status          String    @default("PENDING")
  approvedQuoteId String?
  vendorId        String?
  amountApproved  Float?
  amountPaid      Float     @default(0)
  deliveredAt     DateTime?
  orderIndex      Int       @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedQuote  Quote?           @relation("PartidaApprovedQuote", fields: [approvedQuoteId], references: [id])
  vendor         Vendor?          @relation(fields: [vendorId], references: [id])
  quotes         Quote[]          @relation("PartidaQuotes")
  payments       PartidaPayment[]
  vendorInvoices VendorInvoice[]

  @@index([projectId])
}

model PartidaPayment {
  id                 String   @id @default(cuid())
  partidaId          String
  amount             Float
  type               String   @default("PARTIAL")
  date               DateTime
  method             String
  reference          String?
  receiptUrl         String?
  notes              String?
  percentageOfTotal  Float?
  closesWithDiscount Boolean  @default(false)
  discountAmount     Float?
  discountReason     String?
  createdAt          DateTime @default(now())

  partida ProjectPartida @relation(fields: [partidaId], references: [id], onDelete: Cascade)
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String   @default("COMPANY")
  category       String
  taxId          String?
  contactName    String?
  email          String?
  phone          String
  address        String?
  rating         Float?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes         Quote[]
  expenses       Expense[]
  projectCosts   ProjectCost[]
  partidas       ProjectPartida[]
  vendorInvoices VendorInvoice[]
  maintenances   MaintenanceRequest[] @relation("TicketVendor")
  ticketPayments TicketPayment[]      @relation("TicketPaymentVendor")

  @@index([organizationId])
}

// Polymorphic quote: belongs to a partida (project) OR a ticket (maintenance)
// status: DRAFT | PENDING | APPROVED | REJECTED | SELECTED (ticket-only, when chosen but not approved)
model Quote {
  id                String    @id @default(cuid())
  organizationId    String

  // Polymorphic owner
  partidaId         String?
  ticketId          String?
  projectId         String?   // optional convenience for partida quotes
  propertyId        String?

  vendorId          String

  quoteNumber       String?
  vendorReference   String?
  date              DateTime  @default(now())
  validUntil        DateTime?

  subtotal          Float
  taxAmount         Float     @default(0)
  taxPercent        Float?    @default(12)
  total             Float
  currency          String    @default("GTQ")

  status            String    @default("DRAFT")
  approvalRequestId String?   @unique
  approvedAt        DateTime? // legacy
  approvedBy        String?   // legacy text

  notes             String?
  documentUrl       String?
  pdfUrl            String?   // legacy
  createdById       String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  project            Project?            @relation(fields: [projectId], references: [id])
  partida            ProjectPartida?     @relation("PartidaQuotes", fields: [partidaId], references: [id], onDelete: Cascade)
  ticket             MaintenanceRequest? @relation("TicketQuotes", fields: [ticketId], references: [id], onDelete: Cascade)
  approvalRequest    ApprovalRequest?    @relation("QuoteApproval", fields: [approvalRequestId], references: [id])
  approvedInPartidas ProjectPartida[]    @relation("PartidaApprovedQuote")
  createdBy          User?               @relation("QuoteCreator", fields: [createdById], references: [id])
  items              QuoteItem[]

  @@index([organizationId, status])
  @@index([partidaId])
  @@index([ticketId])
  @@index([vendorId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  quantity    Float
  unit        String?
  unitPrice   Float
  total       Float
  orderIndex  Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// status: PENDING | APPROVED | PAID | REJECTED
model VendorInvoice {
  id             String    @id @default(cuid())
  organizationId String
  vendorId       String
  propertyId     String?
  projectId      String?
  partidaId      String?
  invoiceNumber  String
  date           DateTime
  dueDate        DateTime?
  subtotal       Float
  taxAmount      Float     @default(0)
  total          Float
  currency       String    @default("GTQ")
  status         String    @default("PENDING")
  paidAt         DateTime?
  paidAmount     Float     @default(0)
  balance        Float
  notes          String?
  fileUrl        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor          @relation(fields: [vendorId], references: [id])
  property     Property?       @relation(fields: [propertyId], references: [id])
  project      Project?        @relation(fields: [projectId], references: [id])
  partida      ProjectPartida? @relation(fields: [partidaId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model Employee {
  id              String    @id @default(cuid())
  organizationId  String
  fullName        String
  documentNumber  String
  position        String
  email           String?
  phone           String
  hireDate        DateTime
  terminationDate DateTime?
  status          String    @default("ACTIVE")
  payPeriod       String    @default("MONTHLY")
  payRate         Float
  notes           String?
  imageUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  EmployeeAssignment[]

  @@index([organizationId])
}

model EmployeeAssignment {
  id          String    @id @default(cuid())
  employeeId  String
  projectId   String?
  propertyId  String?
  startDate   DateTime
  endDate     DateTime?
  hoursWorked Float?
  amountPaid  Float?
  notes       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id])
}

model Document {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  name           String
  filePath       String
  fileSize       Int
  mimeType       String
  propertyId     String?
  contractId     String?
  projectId      String?
  uploadedBy     String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id])
  contract     Contract?    @relation(fields: [contractId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([organizationId])
}

model Plan {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  type        String
  filePath    String
  fileSize    Int
  mimeType    String
  modelUrl    String?
  modelStatus String?
  aiAnalysis  String?
  scale       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  message        String
  link           String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// type: EXPENSE | REPLENISHMENT | ADJUSTMENT
model PettyCash {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String   @unique
  balance        Float    @default(0)
  maxBalance     Float    @default(2000)
  currency       String   @default("GTQ")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  movements    PettyCashMovement[]

  @@index([organizationId])
}

model PettyCashMovement {
  id          String   @id @default(cuid())
  pettyCashId String
  type        String
  amount      Float
  description String
  category    String?
  date        DateTime
  reference   String?
  ticketId    String?
  notes       String?
  createdAt   DateTime @default(now())

  pettyCash PettyCash           @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)
  ticket    MaintenanceRequest? @relation(fields: [ticketId], references: [id])
}

// entityType: PROJECT | PARTIDA | TICKET | PAYMENT | QUOTE | APPROVAL
// action: CREATED | UPDATED | DELETED | STATUS_CHANGED | PAYMENT_REGISTERED | QUOTE_ADDED | QUOTE_SELECTED | APPROVED | REJECTED | COSIGNED | ESCALATED | CANCELLED | DELIVERED | APPROVAL_REQUESTED
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  projectId      String?
  action         String
  actorId        String?
  actorName      String?
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@index([entityType, entityId])
}
